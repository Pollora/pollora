<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Multisite, sub-directory network ONLY: the administration of a sub-site
    #
    # WordPress lives in cms/, but a sub-site's URLs are /site2/wp-admin/,
    # /site2/wp-login.php, /site2/wp-includes/...: there is no such file, so the
    # front controller answers (a Laravel page, not the login). These rules
    # send those paths to cms/ and keep the original URL (REQUEST_URI), which is
    # what WordPress reads to find the site.
    #
    # Off by default, on purpose: on a single site a page "wp-admin" can be the
    # child of another page (/about/wp-admin) and WordPress does not reserve the
    # slug, so these rules are not inert there. Remove the leading "# " of the
    # lines below once the site is a sub-directory network. Not needed for a
    # sub-domain network.
    #
    #   * the first path segment is the site's path: [_0-9a-zA-Z-]+, never "cms";
    #   * only what WordPress asks of a sub-site's own URL: wp-admin/,
    #     wp-includes/ (admin and login assets), wp-login.php, wp-signup.php,
    #     wp-activate.php, wp-comments-post.php (the comment form), wp-cron.php
    #     (the cron spawn) and xmlrpc.php. wp-json and wp-content need nothing:
    #     the REST API goes through the front controller and content_url() has
    #     no site prefix;
    #   * only when the target exists in cms/, otherwise the front controller
    #     keeps answering (its 404).
    #
    # /site2/wp-admin without the slash is sent to /site2/wp-admin/ (as
    # WordPress's own network rules do) instead of leaking /cms/wp-admin/.
    #
    # RewriteRule ^(?!cms/)([_0-9a-zA-Z-]+)/wp-admin$ /$1/wp-admin/ [R=301,L]
    # RewriteCond %{DOCUMENT_ROOT}/cms/$1 -f [OR]
    # RewriteCond %{DOCUMENT_ROOT}/cms/$1 -d
    # RewriteRule ^(?!cms/)[_0-9a-zA-Z-]+/((?:wp-admin|wp-includes)(?:/.*)?|(?:wp-login|wp-signup|wp-activate|wp-comments-post|wp-cron|xmlrpc)\.php)$ cms/$1 [L]

    # WordPress Content Directories Are Not Pages...
    #
    # A directory, or the empty index.php WordPress ships in some of them
    # ("Silence is golden"), answered a blank 200 or a 403: either way it told
    # a visitor the directory exists. The front controller answers instead,
    # with the site's own 404. Files in them (CSS, JS, images) are served as
    # before.
    RewriteCond %{REQUEST_FILENAME} -d [OR]
    RewriteCond %{REQUEST_FILENAME} /index\.php$
    RewriteRule ^(cms/wp-content|content)(/|$) index.php [L]

    # Redirect Trailing Slashes If Not A Folder...
    #
    # Only GET and HEAD: a redirected POST or OPTIONS is lost. The REST API is
    # left to WordPress, whose rest_url() ends in a slash. The scheme is stated
    # because behind a proxy that terminates TLS Apache only sees HTTP, and
    # would otherwise send https visitors to http://.
    RewriteCond %{HTTPS} =on [OR]
    RewriteCond %{HTTP:X-Forwarded-Proto} =https
    RewriteRule ^ - [E=POLLORA_SCHEME:https]
    RewriteCond %{ENV:POLLORA_SCHEME} !=https
    RewriteRule ^ - [E=POLLORA_SCHEME:http]
    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
    RewriteCond %{REQUEST_URI} !^/wp-json(/|$)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %{ENV:POLLORA_SCHEME}://%{HTTP_HOST}%1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# BEGIN WordPress
# The directives (lines) between "BEGIN WordPress" and "END WordPress" are
# dynamically generated, and should only be modified via WordPress filters.
# Any changes to the directives between these markers will be overwritten.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteBase /
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>

# END WordPress

# Image sizes made by pollora/media
#
# The file of a declared size is named photo-card-600x400-{signature}.webp and
# never changes while the size does not: a year, immutable. A size that does
# not exist yet is sent to the front controller by the rule above, made at the
# path of its URL and served with the same header; this one covers the files
# Apache serves once they exist.
<IfModule mod_headers.c>
    <FilesMatch "-[a-z0-9_]+(-[0-9]+w)?-[0-9]+x[0-9]+-[0-9a-f]{12}\.(webp|avif|jpe?g|png)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
