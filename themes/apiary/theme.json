{
  "$schema": "https://schemas.wp.org/wp/6.0/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "45rem",
      "wideSize": "80rem"
    },
    "spacing": {
      "units": [
        "%",
        "px",
        "em",
        "rem",
        "vh",
        "vw"
      ]
    },
    "typography": {
      "dropCap": false,
      "defaultFontSizes": false,
      "customFontSize": false
    },
    "border": {
      "radius": true
    },
    "custom": {
      "lineHeight": {
        "tight": 1.25,
        "snug": 1.4,
        "body": 1.75,
        "normal": 1.5
      },
      "fontWeight": {
        "medium": 500,
        "semiBold": 600,
        "bold": 700,
        "extraBold": 800
      }
    }
  },
  "styles": {
    "color": {
      "background": "#ffffff",
      "text": "var(--wp--preset--color--foreground)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--sans)",
      "fontSize": "var(--wp--preset--font-size--base)",
      "lineHeight": "var(--wp--custom--line-height--normal)"
    },
    "spacing": {
      "blockGap": "1.25rem"
    },
    "css": ".wp-block-list a:where(:not(.wp-element-button)), p a:where(:not(.wp-element-button)) { text-underline-offset: 0.2em; text-decoration-thickness: 1px; } :where(code, kbd) { font-family: var(--wp--preset--font-family--mono); font-size: 0.875em; }",
    "elements": {
      "heading": {
        "color": {
          "text": "var(--wp--preset--color--foreground)"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--sans)",
          "fontWeight": "var(--wp--custom--font-weight--bold)",
          "lineHeight": "var(--wp--custom--line-height--tight)",
          "letterSpacing": "-0.025em"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--4-xl)",
          "fontWeight": "var(--wp--custom--font-weight--extra-bold)"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--2-xl)"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xl)",
          "fontWeight": "var(--wp--custom--font-weight--semi-bold)"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--lg)",
          "fontWeight": "var(--wp--custom--font-weight--semi-bold)",
          "lineHeight": "var(--wp--custom--line-height--snug)"
        }
      },
      "h5": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--base)",
          "fontWeight": "var(--wp--custom--font-weight--semi-bold)",
          "lineHeight": "var(--wp--custom--line-height--snug)",
          "letterSpacing": "0"
        }
      },
      "h6": {
        "color": {
          "text": "var(--wp--preset--color--muted)"
        },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xs)",
          "fontWeight": "var(--wp--custom--font-weight--semi-bold)",
          "lineHeight": "var(--wp--custom--line-height--snug)",
          "textTransform": "uppercase",
          "letterSpacing": "0.08em"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--primary)",
          "text": "#ffffff"
        },
        "border": {
          "radius": "var(--wp--preset--border-radius--lg)",
          "width": "0"
        },
        "spacing": {
          "padding": {
            "top": "0.625rem",
            "bottom": "0.625rem",
            "left": "1rem",
            "right": "1rem"
          }
        },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--sm)",
          "fontWeight": "var(--wp--custom--font-weight--semi-bold)",
          "lineHeight": "var(--wp--custom--line-height--tight)",
          "textDecoration": "none"
        },
        "shadow": "0 1px 2px 0 rgb(0 0 0 / 0.05)",
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--primary-hover)",
            "text": "#ffffff"
          }
        },
        ":focus": {
          "outline": {
            "color": "var(--wp--preset--color--ring)",
            "offset": "2px",
            "style": "solid",
            "width": "2px"
          }
        }
      },
      "caption": {
        "color": {
          "text": "var(--wp--preset--color--muted)"
        },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--sm)",
          "lineHeight": "var(--wp--custom--line-height--snug)",
          "textAlign": "center"
        }
      },
      "cite": {
        "color": {
          "text": "var(--wp--preset--color--muted)"
        },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--sm)",
          "fontStyle": "normal",
          "fontWeight": "var(--wp--custom--font-weight--medium)"
        }
      }
    },
    "blocks": {
      "core/heading": {
        "css": "&:not(:first-child) { margin-block-start: calc(var(--wp--style--block-gap) * 2); } & + .wp-block-heading { margin-block-start: var(--wp--style--block-gap); }"
      },
      "core/list": {
        "spacing": {
          "padding": {
            "left": "1.5em"
          }
        },
        "css": "&:where(ul) { list-style: disc; } &:where(ol) { list-style: decimal; } & li { margin-block: 0.375em; padding-inline-start: 0.25em; } & li::marker { color: var(--wp--preset--color--subtle); }",
        "typography": {
          "lineHeight": "var(--wp--custom--line-height--body)"
        },
        "elements": {
          "link": {
            "typography": {
              "textDecoration": "underline"
            },
            ":hover": {
              "color": {
                "text": "var(--wp--preset--color--secondary)"
              }
            }
          }
        }
      },
      "core/quote": {
        "color": {
          "text": "var(--wp--preset--color--foreground)"
        },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--lg)",
          "fontStyle": "italic",
          "lineHeight": "var(--wp--custom--line-height--snug)",
          "fontWeight": "var(--wp--custom--font-weight--medium)"
        },
        "spacing": {
          "padding": {
            "top": "0.25rem",
            "bottom": "0.25rem",
            "left": "1.25rem",
            "right": "0"
          }
        },
        "border": {
          "width": "0 0 0 4px",
          "style": "solid",
          "color": "var(--wp--preset--color--accent)",
          "radius": "0"
        },
        "css": "& p { margin-block: 0.5em; } & p:first-child { margin-block-start: 0; } & cite { display: block; margin-block-start: 0.75em; color: var(--wp--preset--color--muted) !important; font-size: var(--wp--preset--font-size--sm) !important; font-style: normal !important; font-weight: 500 !important; text-transform: none !important; letter-spacing: 0 !important; } & cite::before { content: \"— \"; }"
      },
      "core/pullquote": {
        "color": {
          "text": "var(--wp--preset--color--foreground)"
        },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--2-xl)",
          "fontWeight": "var(--wp--custom--font-weight--semi-bold)",
          "lineHeight": "var(--wp--custom--line-height--snug)",
          "letterSpacing": "-0.015em"
        },
        "spacing": {
          "padding": {
            "top": "2rem",
            "bottom": "2rem",
            "left": "1.5rem",
            "right": "1.5rem"
          }
        },
        "border": {
          "width": "1px 0",
          "style": "solid",
          "color": "var(--wp--preset--color--outline)"
        },
        "css": "& p { margin: 0; } & cite { display: block; margin-block-start: 1em; color: var(--wp--preset--color--muted) !important; font-size: var(--wp--preset--font-size--sm) !important; font-style: normal !important; font-weight: 500 !important; text-transform: none !important; letter-spacing: 0 !important; }"
      },
      "core/separator": {
        "color": {
          "text": "var(--wp--preset--color--outline)"
        },
        "css": "&:not(.is-style-dots) { border: 0; border-block-start: 1px solid; } &:not(.is-style-wide):not(.is-style-dots) { width: 6rem; margin-inline: auto; }"
      },
      "core/table": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--sm)"
        },
        "css": "& { border-collapse: separate !important; border-spacing: 0; width: 100%; border: 1px solid var(--wp--preset--color--outline); border-radius: var(--wp--preset--border-radius--lg); overflow: hidden; } & thead { border: 0 !important; } & tfoot { border: 0 !important; } & th { border: 0 !important; border-block-end: 1px solid var(--wp--preset--color--outline) !important; padding: 0.75rem 1rem !important; text-align: start; } & td { border: 0 !important; border-block-end: 1px solid var(--wp--preset--color--outline) !important; padding: 0.75rem 1rem !important; } & thead th { background: var(--wp--preset--color--surface); color: var(--wp--preset--color--foreground); font-weight: 600; } & tbody tr:last-child th { border-block-end: 0 !important; } & tbody tr:last-child td { border-block-end: 0 !important; }",
        "elements": {
          "link": {
            "typography": {
              "textDecoration": "underline"
            },
            ":hover": {
              "color": {
                "text": "var(--wp--preset--color--secondary)"
              }
            }
          }
        }
      },
      "core/code": {
        "color": {
          "background": "var(--wp--preset--color--foreground)",
          "text": "var(--wp--preset--color--surface)"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--mono)",
          "fontSize": "var(--wp--preset--font-size--sm)",
          "lineHeight": "var(--wp--custom--line-height--snug)"
        },
        "spacing": {
          "padding": {
            "top": "1rem",
            "bottom": "1rem",
            "left": "1.25rem",
            "right": "1.25rem"
          }
        },
        "border": {
          "radius": "var(--wp--preset--border-radius--lg)",
          "width": "0"
        },
        "css": "& { overflow-x: auto; } & code { font-size: inherit; }"
      },
      "core/preformatted": {
        "color": {
          "background": "var(--wp--preset--color--surface)",
          "text": "var(--wp--preset--color--foreground)"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--mono)",
          "fontSize": "var(--wp--preset--font-size--sm)",
          "lineHeight": "var(--wp--custom--line-height--snug)"
        },
        "spacing": {
          "padding": {
            "top": "1rem",
            "bottom": "1rem",
            "left": "1.25rem",
            "right": "1.25rem"
          }
        },
        "border": {
          "radius": "var(--wp--preset--border-radius--lg)",
          "width": "1px",
          "style": "solid",
          "color": "var(--wp--preset--color--outline)"
        },
        "css": "& { overflow-x: auto; }"
      },
      "core/verse": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--sans)",
          "fontStyle": "italic",
          "lineHeight": "var(--wp--custom--line-height--body)"
        },
        "css": "& { padding-inline-start: 1.25rem; border-inline-start: 2px solid var(--wp--preset--color--outline); white-space: pre-wrap; }",
        "elements": {
          "link": {
            "typography": {
              "textDecoration": "underline"
            },
            ":hover": {
              "color": {
                "text": "var(--wp--preset--color--secondary)"
              }
            }
          }
        }
      },
      "core/details": {
        "border": {
          "color": "var(--wp--preset--color--outline)",
          "width": "1px",
          "style": "solid",
          "radius": "var(--wp--preset--border-radius--lg)"
        },
        "spacing": {
          "padding": {
            "top": "0.875rem",
            "bottom": "0.875rem",
            "left": "1.25rem",
            "right": "1.25rem"
          }
        },
        "css": "& summary { cursor: pointer; font-weight: 600; } & summary::marker { color: var(--wp--preset--color--muted); } &[open] summary { margin-block-end: 0.75em; }"
      },
      "core/image": {
        "css": "& img { border-radius: var(--wp--preset--border-radius--lg); } & figcaption { text-align: center; margin-block-start: 0.75em; }"
      },
      "core/gallery": {
        "css": "& img { border-radius: var(--wp--preset--border-radius--md); }"
      },
      "core/group": {
        "css": "&.has-background { padding: 2rem; border-radius: var(--wp--preset--border-radius--xl); }"
      },
      "core/button": {
        "css": "&.is-style-outline > .wp-block-button__link { background: transparent; color: var(--wp--preset--color--foreground); box-shadow: inset 0 0 0 1px var(--wp--preset--color--outline); } &.is-style-outline > .wp-block-button__link:hover { background: var(--wp--preset--color--surface); color: var(--wp--preset--color--foreground); }"
      },
      "core/search": {
        "css": "& .wp-block-search__label { font-weight: 600; font-size: var(--wp--preset--font-size--sm); } & .wp-block-search__input { border: 1px solid var(--wp--preset--color--outline); border-radius: var(--wp--preset--border-radius--lg); padding: 0.625rem 0.875rem; background: #ffffff; } & .wp-block-search__input:focus { outline: 2px solid var(--wp--preset--color--ring); outline-offset: 1px; }"
      },
      "core/post-title": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--3-xl)",
          "fontWeight": "var(--wp--custom--font-weight--bold)",
          "lineHeight": "var(--wp--custom--line-height--tight)",
          "letterSpacing": "-0.025em"
        }
      },
      "core/query-title": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--3-xl)",
          "fontWeight": "var(--wp--custom--font-weight--extra-bold)",
          "lineHeight": "var(--wp--custom--line-height--tight)"
        }
      },
      "core/site-title": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xl)",
          "fontWeight": "var(--wp--custom--font-weight--bold)",
          "lineHeight": "var(--wp--custom--line-height--tight)"
        }
      },
      "core/paragraph": {
        "typography": {
          "lineHeight": "var(--wp--custom--line-height--body)"
        },
        "elements": {
          "link": {
            "typography": {
              "textDecoration": "underline"
            },
            ":hover": {
              "color": {
                "text": "var(--wp--preset--color--secondary)"
              }
            }
          }
        }
      }
    }
  }
}
