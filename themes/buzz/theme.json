{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "customTemplates": [],
    "templateParts": [
        {
            "name": "header",
            "title": "Masthead",
            "area": "header"
        },
        {
            "name": "footer",
            "title": "Colophon",
            "area": "footer"
        }
    ],
    "settings": {
        "appearanceTools": true,
        "useRootPaddingAwareAlignments": true,
        "color": {
            "custom": false,
            "customDuotone": false,
            "customGradient": false,
            "defaultDuotone": false,
            "defaultGradients": false,
            "defaultPalette": false,
            "link": true
        },
        "custom": {
            "fontWeight": {
                "regular": 420,
                "medium": 500,
                "semiBold": 600,
                "bold": 700,
                "black": 900
            },
            "lineHeight": {
                "tight": 1.05,
                "snug": 1.2,
                "body": 1.6,
                "relaxed": 1.75
            }
        },
        "layout": {
            "contentSize": "42rem",
            "wideSize": "78rem"
        },
        "spacing": {
            "defaultSpacingSizes": false,
            "units": ["px", "em", "rem", "vh", "vw", "%"],
            "spacingScale": {
                "operator": "*",
                "increment": 1.5,
                "steps": 0,
                "mediumStep": 0,
                "unit": "rem"
            },
            "spacingSizes": [
                {
                    "name": "Hairline",
                    "slug": "2xs",
                    "size": "0.5rem"
                },
                {
                    "name": "Small",
                    "slug": "xs",
                    "size": "1rem"
                },
                {
                    "name": "Medium",
                    "slug": "sm",
                    "size": "1.5rem"
                },
                {
                    "name": "Column gutter",
                    "slug": "md",
                    "size": "clamp(1.5rem, 3vw, 2.5rem)"
                },
                {
                    "name": "Section",
                    "slug": "lg",
                    "size": "clamp(2.5rem, 6vw, 4.5rem)"
                },
                {
                    "name": "Masthead",
                    "slug": "xl",
                    "size": "clamp(4rem, 9vw, 7rem)"
                }
            ]
        },
        "typography": {
            "dropCap": true,
            "fluid": true,
            "customFontSize": false,
            "defaultFontSizes": false,
            "fontStyle": true,
            "fontWeight": true,
            "letterSpacing": true,
            "lineHeight": true,
            "textTransform": true,
            "writingMode": false,
            "fontFamilies": [
                {
                    "name": "Playfair Display",
                    "slug": "display",
                    "fontFamily": "\"Playfair Display\", ui-serif, Georgia, serif",
                    "fontFace": [
                        {
                            "fontFamily": "Playfair Display",
                            "fontStyle": "normal",
                            "fontWeight": "400 900",
                            "fontDisplay": "swap",
                            "src": ["file:./resources/assets/fonts/PlayfairDisplay-Roman.woff2"]
                        },
                        {
                            "fontFamily": "Playfair Display",
                            "fontStyle": "italic",
                            "fontWeight": "400 900",
                            "fontDisplay": "swap",
                            "src": ["file:./resources/assets/fonts/PlayfairDisplay-Italic.woff2"]
                        }
                    ]
                },
                {
                    "name": "Source Serif 4",
                    "slug": "body",
                    "fontFamily": "\"Source Serif 4\", ui-serif, Georgia, serif",
                    "fontFace": [
                        {
                            "fontFamily": "Source Serif 4",
                            "fontStyle": "normal",
                            "fontWeight": "200 900",
                            "fontDisplay": "swap",
                            "src": ["file:./resources/assets/fonts/SourceSerif4-Roman.woff2"]
                        },
                        {
                            "fontFamily": "Source Serif 4",
                            "fontStyle": "italic",
                            "fontWeight": "200 900",
                            "fontDisplay": "swap",
                            "src": ["file:./resources/assets/fonts/SourceSerif4-Italic.woff2"]
                        }
                    ]
                }
            ],
            "fontSizes": [
                {
                    "name": "Caption",
                    "slug": "caption",
                    "size": "0.8125rem",
                    "fluid": false
                },
                {
                    "name": "Small",
                    "slug": "small",
                    "size": "0.9375rem",
                    "fluid": false
                },
                {
                    "name": "Base",
                    "slug": "base",
                    "size": "1.125rem",
                    "fluid": {
                        "min": "1.0625rem",
                        "max": "1.1875rem"
                    }
                },
                {
                    "name": "Lede",
                    "slug": "lede",
                    "size": "1.375rem",
                    "fluid": {
                        "min": "1.25rem",
                        "max": "1.5rem"
                    }
                },
                {
                    "name": "Headline",
                    "slug": "headline",
                    "size": "2rem",
                    "fluid": {
                        "min": "1.75rem",
                        "max": "2.25rem"
                    }
                },
                {
                    "name": "Article title",
                    "slug": "article-title",
                    "size": "2.75rem",
                    "fluid": {
                        "min": "2.25rem",
                        "max": "3.25rem"
                    }
                },
                {
                    "name": "Masthead",
                    "slug": "masthead",
                    "size": "4rem",
                    "fluid": {
                        "min": "2.75rem",
                        "max": "5.5rem"
                    }
                }
            ]
        },
        "border": {
            "color": true,
            "radius": false,
            "style": false,
            "width": true
        }
    },
    "styles": {
        "color": {
            "background": "var(--wp--preset--color--paper)",
            "text": "var(--wp--preset--color--ink)"
        },
        "spacing": {
            "blockGap": "var(--wp--preset--spacing--sm)",
            "padding": {
                "left": "var(--wp--preset--spacing--xs)",
                "right": "var(--wp--preset--spacing--xs)"
            }
        },
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--body)",
            "fontSize": "var(--wp--preset--font-size--base)",
            "lineHeight": "var(--wp--custom--line-height--body)"
        },
        "elements": {
            "heading": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--display)",
                    "fontWeight": "var(--wp--custom--font-weight--regular)",
                    "lineHeight": "var(--wp--custom--line-height--tight)",
                    "fontStyle": "normal"
                }
            },
            "h1": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--article-title)"
                }
            },
            "h2": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--headline)"
                }
            },
            "h3": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--lede)",
                    "fontWeight": "var(--wp--custom--font-weight--medium)"
                }
            },
            "h4": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--base)",
                    "fontWeight": "var(--wp--custom--font-weight--bold)",
                    "textTransform": "uppercase",
                    "letterSpacing": "0.03em"
                }
            },
            "link": {
                "color": {
                    "text": "var(--wp--preset--color--ink)"
                },
                "typography": {
                    "textDecoration": "underline"
                },
                ":hover": {
                    "color": {
                        "text": "var(--wp--preset--color--rubric)"
                    }
                }
            },
            "caption": {
                "color": {
                    "text": "var(--wp--preset--color--caption)"
                },
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--body)",
                    "fontSize": "var(--wp--preset--font-size--caption)",
                    "fontStyle": "italic"
                }
            }
        },
        "blocks": {
            "core/site-title": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--display)",
                    "fontSize": "var(--wp--preset--font-size--masthead)",
                    "fontWeight": "var(--wp--custom--font-weight--black)",
                    "lineHeight": "var(--wp--custom--line-height--tight)"
                }
            },
            "core/navigation": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--body)",
                    "fontSize": "var(--wp--preset--font-size--small)",
                    "fontWeight": "var(--wp--custom--font-weight--semiBold)",
                    "textTransform": "uppercase",
                    "letterSpacing": "0.08em"
                },
                "css": "& .wp-block-navigation-item > a { text-decoration: none; } & .wp-block-navigation-item > a:hover { color: var(--wp--preset--color--rubric); }"
            },
            "core/post-title": {
                "css": "& a { text-decoration: none; } & a:hover { color: var(--wp--preset--color--rubric); }"
            },
            "core/post-terms": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--body)",
                    "fontSize": "var(--wp--preset--font-size--caption)",
                    "fontWeight": "var(--wp--custom--font-weight--bold)",
                    "textTransform": "uppercase",
                    "letterSpacing": "0.08em"
                },
                "color": {
                    "text": "var(--wp--preset--color--rubric)"
                },
                "css": "& a { text-decoration: none; }"
            },
            "core/post-date": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--body)",
                    "fontSize": "var(--wp--preset--font-size--caption)",
                    "fontStyle": "italic"
                },
                "color": {
                    "text": "var(--wp--preset--color--caption)"
                }
            },
            "core/post-author-name": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--body)",
                    "fontSize": "var(--wp--preset--font-size--caption)",
                    "fontWeight": "var(--wp--custom--font-weight--semiBold)"
                }
            },
            "core/separator": {
                "color": {
                    "text": "var(--wp--preset--color--rule)"
                }
            },
            "core/quote": {
                "border": {
                    "color": "var(--wp--preset--color--rubric)",
                    "width": "0 0 0 3px"
                },
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--display)",
                    "fontSize": "var(--wp--preset--font-size--lede)",
                    "fontStyle": "italic",
                    "lineHeight": "var(--wp--custom--line-height--snug)"
                },
                "spacing": {
                    "padding": {
                        "left": "var(--wp--preset--spacing--sm)"
                    }
                }
            },
            "core/pullquote": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--display)",
                    "fontSize": "var(--wp--preset--font-size--headline)",
                    "fontStyle": "italic",
                    "lineHeight": "var(--wp--custom--line-height--snug)"
                },
                "border": {
                    "color": "var(--wp--preset--color--ink)",
                    "width": "3px 0"
                }
            },
            "core/button": {
                "border": {
                    "radius": "0px",
                    "width": "1px",
                    "color": "var(--wp--preset--color--ink)"
                },
                "color": {
                    "background": "var(--wp--preset--color--paper)",
                    "text": "var(--wp--preset--color--ink)"
                },
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--body)",
                    "fontSize": "var(--wp--preset--font-size--small)",
                    "fontWeight": "var(--wp--custom--font-weight--semiBold)",
                    "textTransform": "uppercase",
                    "letterSpacing": "0.08em"
                },
                "css": "&:hover { background: var(--wp--preset--color--ink); color: var(--wp--preset--color--paper); }"
            }
        }
    }
}
