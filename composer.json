{
    "name": "pollora/pollora",
    "type": "project",
    "description": "The skeleton application for the Pollora framework.",
    "keywords": [
        "pollora",
        "laravel",
        "framework",
        "wordpress"
    ],
    "license": "MIT",
    "homepage": "https://pollora.dev",
    "support": {
        "docs": "https://pollora.dev",
        "issues": "https://github.com/Pollora/framework/issues",
        "source": "https://github.com/Pollora/pollora"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://repo.wp-packages.org"
        }
    ],
    "require": {
        "php": "^8.3",
        "barryvdh/laravel-ide-helper": "^3.7",
        "johnpbloch/wordpress": "^7.1",
        "laravel/framework": "^13.33",
        "laravel/sanctum": "^4.3 || ^5.0",
        "laravel/tinker": "^3.0",
        "pollora/framework": "^13.32@beta"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.27",
        "laravel/sail": "^1.53",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12",
        "laravel/pail": "^1.2.5"
    },
    "autoload": {
        "files": [
            "app/helpers/bootstrap.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan pollora:env:setup --install"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php artisan pollora:install"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "test:install": "@php tests/install/run.php",
        "test:integration": "@php tests/integration.php",
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "wordpress-install-dir": "public/cms",
        "installer-paths": {
            "public/content/mu-plugins/{$name}/": [
                "type:wordpress-muplugin"
            ],
            "public/content/plugins/{$name}/": [
                "type:wordpress-plugin"
            ],
            "public/content/themes/{$name}/": [
                "type:wordpress-theme"
            ]
        },
        "merge-plugin": {
            "include": [
                "Modules/*/composer.json"
            ]
        },
        "laravel": []
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": {
            "pollora/*": "source",
            "*": "dist"
        },
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "johnpbloch/wordpress-core-installer": true,
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "pollora/helper-overrider": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "prefer-stable": true
}
